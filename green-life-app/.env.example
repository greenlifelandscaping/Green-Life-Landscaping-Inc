# Required — get from https://resend.com/api-keys
RESEND_API_KEY=

# Optional — where contact form submissions are delivered
# Defaults to greenlife.contacts@gmail.com if unset.
CONTACT_INBOX=greenlife.contacts@gmail.com

# Optional — the "from" address on outbound emails.
# While testing on a non-verified domain, use Resend's sandbox:
#   onboarding@resend.dev
# Once you verify a domain at https://resend.com/domains, switch to e.g.:
#   "Green Life Landscaping <noreply@greenlifelandscaping.com>"
CONTACT_FROM="Green Life Website <onboarding@resend.dev>"

# Required — Google Maps key for the contact form's address autocomplete.
# Browser-side key; must be restricted in GCP Console to greenlifelandscaping.us
# domains + APIs: Maps JavaScript API and Places API only.
# Create at https://console.cloud.google.com → APIs & Services → Credentials.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
