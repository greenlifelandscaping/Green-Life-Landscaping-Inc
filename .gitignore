# ============================================================
# Green Life Landscaping — repository-wide ignores
# ============================================================

# Node / Next.js (inside green-life-app/)
node_modules
**/node_modules
.pnp
.pnp.js
.next
**/.next
.swc
**/.swc
out
**/out
build
dist
coverage
*.tsbuildinfo
next-env.d.ts

# Environment & secrets — NEVER commit
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# OS junk
.DS_Store
**/.DS_Store
Thumbs.db
.AppleDouble
.LSOverride
._*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / IDE
.idea
.vscode/*
!.vscode/extensions.json
.history
*.swp
*.swo

# Deployment
.vercel

# Claude Code — keep shared settings, ignore per-machine local settings
.claude/settings.local.json
.claude/.credentials.json

# Temp & misc
*.tmp
*.bak
.thumbnail
